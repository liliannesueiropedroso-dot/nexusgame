1. Corrección del Componente Numérico (NumericInput.tsx)
Este componente soluciona el problema de edición de parámetros donde no se podía escribir desde cero o borrar correctamente:

TypeScript
import React, { useState, useEffect } from 'react';

interface NumericInputProps {
  value: number;
  onChange: (val: number) => void;
  step?: number;
  min?: number;
  max?: number;
  label?: string;
}

export const NumericInput: React.FC<NumericInputProps> = ({
  value,
  onChange,
  step = 0.1,
  min,
  max,
  label
}) => {
  const [textVal, setTextVal] = useState(value.toString());

  useEffect(() => {
    setTextVal(value.toString());
  }, [value]);

  const handleChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const raw = e.target.value;
    setTextVal(raw);

    if (raw === '' || raw === '-' || raw === '.') return;

    const parsed = parseFloat(raw);
    if (!isNaN(parsed)) {
      if (min !== undefined && parsed < min) return;
      if (max !== undefined && parsed > max) return;
      onChange(parsed);
    }
  };

  const handleBlur = () => {
    if (textVal === '' || isNaN(parseFloat(textVal))) {
      setTextVal(value.toString());
    } else {
      setTextVal(parseFloat(textVal).toString());
    }
  };

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: '4px', width: '100%' }}>
      {label && <span style={{ fontSize: '11px', color: '#94a3b8' }}>{label}</span>}
      <input
        type="text"
        value={textVal}
        onChange={handleChange}
        onBlur={handleBlur}
        style={{
          background: '#0f1117',
          border: '1px solid #262f40',
          color: '#f1f5f9',
          padding: '6px 10px',
          borderRadius: '6px',
          fontSize: '13px',
          outline: 'none',
          width: '100%'
        }}
      />
    </div>
  );
};
