/**
 * Núcleo de Biblioteca, Auto-Cableado, Persistencia, Red y Portales
 * Diseñado para integrarse directamente en un motor 2D/3D.
 */

export class EventBus {
  constructor() {
    this.listeners = new Map();
  }

  on(eventName, handler) {
    if (!this.listeners.has(eventName)) {
      this.listeners.set(eventName, new Set());
    }
    this.listeners.get(eventName).add(handler);
    return () => this.off(eventName, handler);
  }

  off(eventName, handler) {
    const set = this.listeners.get(eventName);
    if (set) set.delete(handler);
  }

  emit(eventName, payload = {}) {
    const set = this.listeners.get(eventName);
    if (!set) return;
    for (const handler of Array.from(set)) {
      handler(payload);
    }
  }
}

export class BehaviorRegistry {
  constructor() {
    this.definitions = new Map();
  }

  register(definition) {
    if (!definition || !definition.id) {
      throw new Error("El comportamiento requiere un 'id' único.");
    }
    this.definitions.set(definition.id, {
      defaultParams: {},
      inputs: [],
      outputs: [],
      contexts: ["gameplay"],
      onInit: null,
      onStart: null,
      onUpdate: null,
      onEvent: null,
      onDestroy: null,
      ...definition
    });
  }

  get(id) {
    return this.definitions.get(id) || null;
  }

  list() {
    return Array.from(this.definitions.values());
  }
}

export class PersistenceStore {
  constructor(storageKey = "engine_player_save_v1", remoteAdapter = null) {
    this.storageKey = storageKey;
    this.remoteAdapter = remoteAdapter; // Opcional: { load(userId), save(userId, state) }
    this.processedActionIds = new Set();
    this.state = {
      playerId: "local_player",
      coins: 0,
      inventory: {},       // { [itemId]: quantity }
      collectedNodes: {},  // { [nodeId]: timestamp }
      quests: {},
      unlocked: {}
    };
  }

  canExecuteAction(actionId) {
    if (!actionId) return true;
    if (this.processedActionIds.has(actionId)) return false;
    this.processedActionIds.add(actionId);
    if (this.processedActionIds.size > 5000) {
      const first = this.processedActionIds.values().next().value;
      this.processedActionIds.delete(first);
    }
    return true;
  }

  addItem(itemId, amount = 1, actionId = null) {
    if (!itemId || amount <= 0) return false;
    if (!this.canExecuteAction(actionId)) return false;
    const current = this.state.inventory[itemId] || 0;
    this.state.inventory[itemId] = current + amount;
    return true;
  }

  consumeItem(itemId, amount = 1, actionId = null) {
    if (!itemId || amount <= 0) return false;
    if (!this.canExecuteAction(actionId)) return false;
    const current = this.state.inventory[itemId] || 0;
    if (current < amount) return false;
    this.state.inventory[itemId] = current - amount;
    if (this.state.inventory[itemId] <= 0) {
      delete this.state.inventory[itemId];
    }
    return true;
  }

  markNodeCollected(nodeId, respawnSeconds = 30, actionId = null) {
    if (!nodeId) return false;
    if (!this.canExecuteAction(actionId)) return false;
    const now = Date.now();
    const collectedAt = this.state.collectedNodes[nodeId];
    if (collectedAt && now - collectedAt < respawnSeconds * 1000) {
      return false; // Aún en enfriamiento/recolectado
    }
    this.state.collectedNodes[nodeId] = now;
    return true;
  }

  isNodeAvailable(nodeId, respawnSeconds = 30) {
    const collectedAt = this.state.collectedNodes[nodeId];
    if (!collectedAt) return true;
    return (Date.now() - collectedAt) >= respawnSeconds * 1000;
  }

  async save(userId = null) {
    if (userId) this.state.playerId = userId;
    const serialized = JSON.stringify(this.state);
    try {
      if (typeof localStorage !== "undefined") {
        localStorage.setItem(this.storageKey, serialized);
      }
    } catch (_) {}

    if (this.remoteAdapter && typeof this.remoteAdapter.save === "function") {
      await this.remoteAdapter.save(this.state.playerId, this.state);
    }
    return this.state;
  }

  async load(userId = null) {
    if (userId) this.state.playerId = userId;
    try {
      if (typeof localStorage !== "undefined") {
        const raw = localStorage.getItem(this.storageKey);
        if (raw) {
          this.state = { ...this.state, ...JSON.parse(raw) };
        }
      }
    } catch (_) {}

    if (this.remoteAdapter && typeof this.remoteAdapter.load === "function") {
      const remoteData = await this.remoteAdapter.load(this.state.playerId);
      if (remoteData && typeof remoteData === "object") {
        this.state = { ...this.state, ...remoteData };
      }
    }
    return this.state;
  }
}

export class PortalBridge {
  constructor(bus) {
    this.bus = bus;
    this.portal = this._detectPortal();
    this.gameplayActive = false;
  }

  _detectPortal() {
    if (typeof window === "undefined") return "server";
    if (window.PokiSDK) return "poki";
    if (window.CrazyGames && window.CrazyGames.SDK) return "crazygames";
    if (window.playgama || window.Playgama) return "playgama";
    return "web";
  }

  async init() {
    if (this.portal === "poki" && window.PokiSDK?.init) {
      await window.PokiSDK.init();
    } else if (this.portal === "crazygames" && window.CrazyGames?.SDK?.init) {
      await window.CrazyGames.SDK.init();
    }
    this.bus.emit("portal:ready", { portal: this.portal });
  }

  gameplayStart() {
    if (this.gameplayActive) return;
    this.gameplayActive = true;
    if (this.portal === "poki" && window.PokiSDK?.gameplayStart) {
      window.PokiSDK.gameplayStart();
    } else if (this.portal === "crazygames" && window.CrazyGames?.SDK?.game?.gameplayStart) {
      window.CrazyGames.SDK.game.gameplayStart();
    }
    this.bus.emit("portal:gameplayStart");
  }

  gameplayStop() {
    if (!this.gameplayActive) return;
    this.gameplayActive = false;
    if (this.portal === "poki" && window.PokiSDK?.gameplayStop) {
      window.PokiSDK.gameplayStop();
    } else if (this.portal === "crazygames" && window.CrazyGames?.SDK?.game?.gameplayStop) {
      window.CrazyGames.SDK.game.gameplayStop();
    }
    this.bus.emit("portal:gameplayStop");
  }

  async showRewardedAd(onReward) {
    this.gameplayStop();
    let granted = false;
    try {
      if (this.portal === "poki" && window.PokiSDK?.rewardedBreak) {
        granted = Boolean(await window.PokiSDK.rewardedBreak());
      } else if (this.portal === "crazygames" && window.CrazyGames?.SDK?.ad?.requestAd) {
        await new Promise((resolve) => {
          window.CrazyGames.SDK.ad.requestAd("rewarded", {
            adFinished: () => { granted = true; resolve(); },
            adError: () => resolve(),
            adDismissed: () => resolve()
          });
        });
      } else {
        // Fallback en entorno local/web sin SDK externo
        granted = true;
      }
    } catch (_) {
      granted = false;
    }

    if (granted && typeof onReward === "function") {
      onReward();
    }
    this.gameplayStart();
    return granted;
  }
}

export class EngineWiringSystem {
  constructor(registry, persistence, portalBridge) {
    this.registry = registry;
    this.persistence = persistence;
    this.portalBridge = portalBridge;
    this.bus = new EventBus();
    this.entities = new Map();
    this.wiringLinks = [];
    this.archetypes = new Map();
    this.sceneContext = "gameplay"; // "menu" | "gameplay" | "inventory" | etc.
    this._registerDefaultArchetypes();
  }

  setSceneContext(context) {
    this.sceneContext = context;
    this.bus.emit("scene:contextChanged", { context });
  }

  registerArchetype(name, recipe) {
    this.archetypes.set(name, recipe);
  }

  _registerDefaultArchetypes() {
    // 1. Recolectable (cristal, moneda, recurso, fruta)
    this.registerArchetype("collectible", {
      behaviors: [
        { id: "float_bob", params: { amplitude: 0.2, speed: 2.5 }, source: "archetype:collectible" },
        { id: "collectible_node", params: { itemId: "crystal", amount: 1, respawnSec: 30, radius: 1.5 }, source: "archetype:collectible" }
      ],
      autoWire: [
        {
          fromBehavior: "collectible_node",
          signal: "onCollected",
          toRole: "player",
          toBehavior: "inventory_holder",
          action: "receiveItem"
        }
      ]
    });

    // 2. Caña de pescar
    this.registerArchetype("fishing_rod", {
      behaviors: [
        { id: "equippable_tool", params: { slot: "hand", toolType: "rod" }, source: "archetype:fishing_rod" },
        { id: "fishing_mechanic", params: { castRange: 8, biteTimeSec: 2.0, fishPool: ["fish_common", "fish_rare"] }, source: "archetype:fishing_rod" }
      ],
      autoWire: [
        {
          fromBehavior: "fishing_mechanic",
          signal: "onFishCaught",
          toRole: "player",
          toBehavior: "inventory_holder",
          action: "receiveItem"
        }
      ]
    });

    // 3. Red de captura / recolección en área
    this.registerArchetype("capture_net", {
      behaviors: [
        { id: "equippable_tool", params: { slot: "hand", toolType: "net" }, source: "archetype:capture_net" },
        { id: "area_net_capture", params: { radius: 3.5, maxTargets: 5, cooldownSec: 1.2 }, source: "archetype:capture_net" }
      ],
      autoWire: [
        {
          fromBehavior: "area_net_capture",
          signal: "onBatchCaptured",
          toRole: "player",
          toBehavior: "inventory_holder",
          action: "receiveBatch"
        }
      ]
    });

    // 4. Bote / Vehículo acuático
    this.registerArchetype("boat", {
      behaviors: [
        { id: "water_float", params: { waterLevel: 0, buoyancy: 12, drag: 2.5 }, source: "archetype:boat" },
        { id: "vehicle_driver", params: { maxSpeed: 11, turnSpeed: 2.2, seatOffset: { x: 0, y: 1, z: 0 } }, source: "archetype:boat" }
      ],
      autoWire: [
        {
          fromBehavior: "vehicle_driver",
          signal: "onBoardStateChanged",
          toRole: "camera",
          toBehavior: "camera_follow",
          action: "setTarget"
        }
      ]
    });

    // 5. Enemigo con IA FSM + Vida
    this.registerArchetype("enemy_fsm", {
      behaviors: [
        { id: "health_system", params: { maxHp: 100, hp: 100, invulnSec: 0.4 }, source: "archetype:enemy_fsm" },
        { id: "ai_fsm", params: { aggroRange: 10, attackRange: 2.0, fleeHpRatio: 0.2 }, source: "archetype:enemy_fsm" }
      ],
      autoWire: [
        {
          fromBehavior: "health_system",
          signal: "onDied",
          toRole: "player",
          toBehavior: "inventory_holder",
          action: "receiveDrop"
        }
      ]
    });
  }

  createEntity({ id, name, role = "generic", transform = { x: 0, y: 0, z: 0, rotY: 0 }, net = { replicated: false, ownerId: null } }) {
    const entity = {
      id,
      name: name || id,
      role,
      transform,
      net,
      behaviors: [],
      started: false
    };
    this.entities.set(id, entity);
    this.bus.emit("entity:created", { entity });
    return entity;
  }

  addBehavior(entityId, behaviorId, params = {}, source = "manual") {
    const entity = this.entities.get(entityId);
    const def = this.registry.get(behaviorId);
    if (!entity || !def) return null;

    const existing = entity.behaviors.find((b) => b.id === behaviorId);
    if (existing) {
      existing.params = { ...existing.params, ...params };
      this.bus.emit("behavior:updated", { entity, behavior: existing });
      return existing;
    }

    const instance = {
      id: behaviorId,
      name: def.name || behaviorId,
      source,
      enabled: true,
      params: { ...def.defaultParams, ...params },
      state: {},
      inputs: def.inputs || [],
      outputs: def.outputs || [],
      contexts: def.contexts || ["gameplay"],
      _def: def
    };

    entity.behaviors.push(instance);
    if (typeof def.onInit === "function") {
      def.onInit(entity, instance, this);
    }
    if (entity.started && typeof def.onStart === "function") {
      def.onStart(entity, instance, this);
    }

    this.bus.emit("behavior:added", { entity, behavior: instance });
    return instance;
  }

  applyArchetype(entityId, archetypeName) {
    const entity = this.entities.get(entityId);
    const recipe = this.archetypes.get(archetypeName);
    if (!entity || !recipe) return;

    for (const b of recipe.behaviors || []) {
      this.addBehavior(entityId, b.id, b.params, b.source || `archetype:${archetypeName}`);
    }

    for (const rule of recipe.autoWire || []) {
      const targets = Array.from(this.entities.values()).filter((e) => e.role === rule.toRole);
      for (const target of targets) {
        const hasTargetBehavior = target.behaviors.some((tb) => tb.id === rule.toBehavior);
        if (hasTargetBehavior) {
          this.wire({
            sourceEntityId: entity.id,
            sourceBehavior: rule.fromBehavior,
            signal: rule.signal,
            targetEntityId: target.id,
            targetBehavior: rule.toBehavior,
            action: rule.action,
            auto: true
          });
        }
      }
    }

    this.bus.emit("archetype:applied", { entity, archetypeName });
  }

  wire(link) {
    const exists = this.wiringLinks.some(
      (l) =>
        l.sourceEntityId === link.sourceEntityId &&
        l.sourceBehavior === link.sourceBehavior &&
        l.signal === link.signal &&
        l.targetEntityId === link.targetEntityId &&
        l.targetBehavior === link.targetBehavior &&
        l.action === link.action
    );
    if (!exists) {
      this.wiringLinks.push({ ...link, id: `link_${Date.now()}_${Math.random().toString(36).slice(2, 7)}` });
      this.bus.emit("wiring:changed", { links: this.wiringLinks });
    }
  }

  emitBehaviorSignal(sourceEntityId, sourceBehaviorId, signal, data = {}) {
    this.bus.emit("behavior:signal", { sourceEntityId, sourceBehaviorId, signal, data });

    const matchingLinks = this.wiringLinks.filter(
      (l) => l.sourceEntityId === sourceEntityId && l.sourceBehavior === sourceBehaviorId && l.signal === signal
    );

    for (const link of matchingLinks) {
      const targetEntity = this.entities.get(link.targetEntityId);
      if (!targetEntity) continue;
      const targetBehavior = targetEntity.behaviors.find((b) => b.id === link.targetBehavior && b.enabled);
      if (targetBehavior && typeof targetBehavior._def.onEvent === "function") {
        targetBehavior._def.onEvent(targetEntity, targetBehavior, this, link.action, data);
      }
    }
  }

  /**
   * Devuelve la vista lista para renderizar en el Panel de Mecánicas del editor
   */
  getInspectorView(entityId) {
    const entity = this.entities.get(entityId);
    if (!entity) return null;

    return {
      entityId: entity.id,
      entityName: entity.name,
      role: entity.role,
      behaviors: entity.behaviors.map((b) => ({
        id: b.id,
        name: b.name,
        source: b.source,
        enabled: b.enabled,
        contexts: b.contexts,
        params: b.params,
        incomingLinks: this.wiringLinks.filter(
          (l) => l.targetEntityId === entity.id && l.targetBehavior === b.id
        ),
        outgoingLinks: this.wiringLinks.filter(
          (l) => l.sourceEntityId === entity.id && l.sourceBehavior === b.id
        )
      }))
    };
  }

  startAll() {
    for (const entity of this.entities.values()) {
      if (entity.started) continue;
      entity.started = true;
      for (const b of entity.behaviors) {
        if (b.enabled && typeof b._def.onStart === "function") {
          b._def.onStart(entity, b, this);
        }
      }
    }
  }

  update(dt) {
    const clampedDt = Math.min(Math.max(dt || 0, 0), 0.05);
    for (const entity of this.entities.values()) {
      for (const b of entity.behaviors) {
        if (!b.enabled) continue;
        if (Array.isArray(b.contexts) && !b.contexts.includes(this.sceneContext)) continue;
        if (typeof b._def.onUpdate === "function") {
          b._def.onUpdate(entity, b, this, clampedDt);
        }
      }
    }
  }
}
