if (drag.kind === 'collider') {
  const dx = stagePt.x - drag.startStageX;
  const dy = stagePt.y - drag.startStageY;
  drag.changed = true;
  const baseCols =
    drag.initialObj.colliders && drag.initialObj.colliders.length > 0
      ? structuredClone(drag.initialObj.colliders)
      : [createDefaultColliderForObject(drag.initialObj, false)];
  const col = baseCols[0];
  const sx = Math.max(0.05, Math.abs(drag.initialObj.transform.scaleX));
  const sy = Math.max(0.05, Math.abs(drag.initialObj.transform.scaleY));
  const ldx = dx / sx;
  const ldy = dy / sy;

  if (drag.handleType === 'col-move') {
    col.offsetX = roundTo(col.offsetX + ldx, 1);
    col.offsetY = roundTo(col.offsetY + ldy, 1);
  } else if (drag.handleType === 'col-r') {
    col.radius = Math.max(4, roundTo(col.radius + ldx, 1));
  } else if (drag.handleType === 'col-e') {
    col.width = Math.max(4, roundTo(col.width + ldx, 1));
    col.offsetX = roundTo(col.offsetX + ldx * 0.5, 1);
  } else if (drag.handleType === 'col-w') {
    col.width = Math.max(4, roundTo(col.width - ldx, 1));
    col.offsetX = roundTo(col.offsetX + ldx * 0.5, 1);
  } else if (drag.handleType === 'col-s') {
    col.height = Math.max(4, roundTo(col.height + ldy, 1));
    col.offsetY = roundTo(col.offsetY + ldy * 0.5, 1);
  } else if (drag.handleType === 'col-n') {
    col.height = Math.max(4, roundTo(col.height - ldy, 1));
    col.offsetY = roundTo(col.offsetY + ldy * 0.5, 1);
  }

  const updated = drag.initialObjects.map((o) =>
    o.id === drag.targetId ? { ...o, colliders: baseCols } : o
  );
  onPreviewObjectsChange(updated);
  return;
}
