function createExportMultiplayerBridge(sceneData) {
  var mpCfg = sceneData && sceneData.multiplayer;
  if (!mpCfg || !mpCfg.enabled || typeof WebSocket === 'undefined') return null;
  var proto = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
  var wsUrl = mpCfg.serverUrl || (proto + '//' + window.location.host + '/ws/multiplayer');
  var playerId = 'p_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 6);
  var remotes = new Map();
  var ws = null;
  var lastSend = 0;

  try {
    ws = new WebSocket(wsUrl);
    ws.addEventListener('open', function () {
      ws.send(JSON.stringify({
        type: 'join',
        roomId: mpCfg.roomId || 'sala_global',
        playerId: playerId,
        name: 'Jugador_' + playerId.slice(-4),
        mode: (gameData && gameData.mode) || '2d',
        sceneId: sceneData.id,
        maxPlayers: mpCfg.maxPlayers || 16
      }));
    });
    ws.addEventListener('message', function (ev) {
      try {
        var msg = JSON.parse(String(ev.data));
        if (msg.type === 'room_snapshot' && msg.snapshot) {
          remotes.clear();
          (msg.snapshot.players || []).forEach(function (p) {
            if (p.playerId !== playerId) remotes.set(p.playerId, p);
          });
        } else if ((msg.type === 'player_joined' || msg.type === 'player_state') && msg.player) {
          if (msg.player.playerId !== playerId) remotes.set(msg.player.playerId, msg.player);
        } else if (msg.type === 'player_left') {
          remotes.delete(String(msg.playerId || ''));
        }
      } catch (_) {}
    });
  } catch (_) {}

  return {
    sendPose: function (pose) {
      if (!ws || ws.readyState !== 1) return;
      var now = performance.now();
      if (now - lastSend < Math.round(1000 / Math.max(2, mpCfg.syncRateHz || 12))) return;
      lastSend = now;
      ws.send(JSON.stringify(Object.assign({ type: 'state_update' }, pose)));
    },
    getRemotes: function () { return Array.from(remotes.values()); },
    close: function () { try { if (ws) ws.close(); } catch (_) {} }
  };
}
